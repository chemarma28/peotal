<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="v1-1" author="novorock">
        <preConditions onFail="WARN">
            <not>
                <tableExists tableName="contact" />
            </not>
        </preConditions>

        <createTable tableName="contact">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"></constraints>
            </column>
            <column name="first_name" type="varchar(32)" defaultValue="">
                <constraints nullable="false"></constraints>
            </column>
            <column name="last_name" type="varchar(32)">
                <constraints nullable="false"></constraints>
            </column>
            <column name="email" type="varchar(64)">
                <constraints nullable="false"></constraints>
            </column>
            <column name="password" type="varchar(32)">
                <constraints nullable="false"></constraints>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="v1-2" author="novorock">
        <preConditions onFail="WARN">
            <not>
                <tableExists tableName="monthly_expense" />
            </not>
        </preConditions>

        <createTable tableName="monthly_expense">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"></constraints>
            </column>
            <column name="name" type="varchar(10)">
                <constraints nullable="false" unique="true"></constraints>
            </column>
            <column name="balance" type="decimal(19, 3)" defaultValue="0">
                <constraints nullable="false"></constraints>
            </column>
            <column name="contact_id" type="bigint">
                <constraints nullable="false"
                             validateForeignKey="true"
                             foreignKeyName="monthly_expense_contact_fk"
                             referencedTableName="contact"
                             referencedColumnNames="id"></constraints>
            </column>
            <column name="month_date" type="datetime">
                <constraints nullable="false"></constraints>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="v1-3" author="novorock">
        <preConditions onFail="WARN">
            <not>
                <tableExists tableName="expense_card" />
            </not>
        </preConditions>

        <createTable tableName="expense_card">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"></constraints>
            </column>
            <column name="name" type="varchar(10)">
                <constraints nullable="false" unique="true"></constraints>
            </column>
            <column name="amount" type="decimal(19, 3)" defaultValue="0">
                <constraints nullable="false"></constraints>
            </column>
            <column name="contact_id" type="bigint">
                <constraints nullable="false"
                             validateForeignKey="true"
                             foreignKeyName="card_contact_fk"
                             referencedTableName="contact"
                             referencedColumnNames="id"></constraints>
            </column>
            <column name="card_date" type="datetime">
                <constraints nullable="false"></constraints>
            </column>
            <column name="description" type="varchar(255)" defaultValue="">
                <constraints nullable="false"></constraints>
            </column>
            <column name="monthly_expense_id" type="bigint">
                <constraints nullable="false"
                             validateForeignKey="true"
                             foreignKeyName="card_monthly_expense_fk"
                             referencedTableName="monthly_expense"
                             referencedColumnNames="id"></constraints>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>