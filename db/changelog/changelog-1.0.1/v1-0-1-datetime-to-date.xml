<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="v1.0.1-1" author="novorock">
        <preConditions onFail="WARN">
            <tableExists tableName="monthly_expense" />   
        </preConditions>

        <modifyDataType columnName="month_date" newDataType="date" tableName="monthly_expense"></modifyDataType>
    </changeSet>

    <changeSet id="v1.0.1-2" author="novorock">
        <preConditions onFail="WARN">
            <tableExists tableName="expense_card" />   
        </preConditions>

        <modifyDataType columnName="card_date" newDataType="date" tableName="expense_card"></modifyDataType>
    </changeSet>
</databaseChangeLog>