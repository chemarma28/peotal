<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%level] %d{yyyy-MM-dd HH:mm:ss} %class.%method at line %line - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.flywaydb" level="INFO" />

    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>